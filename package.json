{
  "name": "dungeon-master",
  "version": "0.1.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPattern=tests/unit",
    "test:routing": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPattern=tests/routing",
    "test:contract": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPattern=tests/contract",
    "test:separation": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPattern=tests/separation",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPattern=tests/e2e --testTimeout=120000",
    "test:offline": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPattern=tests/(unit|routing)"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.0.0",
    "express": "^4.18.0"
  },
  "devDependencies": {
    "jest": "^29.0.0"
  },
  "jest": {
    "testEnvironment": "node"
  }
}
