# Normalize line endings to LF in the repository for all text files.
# Git will convert to the platform's native endings on checkout,
# but the stored content is always LF — avoiding noisy cross-platform diffs.

* text=auto

*.md   text eol=lf
*.json text eol=lf
*.js   text eol=lf
*.ts   text eol=lf
*.txt  text eol=lf
*.env  text eol=lf
